# Your live site URL (sitemap, canonical links, share previews).
# Leave empty on Vercel until you have your own domain — the Vercel address is used automatically.
SITE_URL=

# Contact form delivery (optional — pick ONE):
# 1) Free key from https://web3forms.com (enter your email, they send you a key)
PUBLIC_WEB3FORMS_KEY=
# 2) Or a Formspree form URL from https://formspree.io
PUBLIC_CONTACT_ENDPOINT=
# If both are empty, the form opens the visitor's email app with the message ready.

# Designed contact emails via Resend (https://resend.com) — runs as a Vercel function
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
# Optional, needs a verified domain in Resend: also sends visitors a "thanks" reply
# RESEND_FROM=Your Name <hello@your-domain.com>
