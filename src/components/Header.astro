---
import Icon from './Icon.astro';
import { profile } from '../data/site';
import { languages, localePath, stripLang, useT, type Lang, type UiKey } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useT(lang);

const nav: { key: UiKey; href: string }[] = [
  { key: 'nav.projects', href: '/projects' },
  { key: 'nav.about', href: '/about' },
  { key: 'nav.contact', href: '/contact' },
];

const basePath = stripLang(Astro.url.pathname);
const current = basePath.replace(/\/$/, '') || '/';
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-zinc-100 bg-white/85 backdrop-blur dark:border-zinc-900 dark:bg-zinc-950/85">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={localePath('/', lang)} class="flex items-center gap-2.5 font-semibold text-zinc-900 dark:text-zinc-50">
      {profile.photo && <img src={profile.photo} alt="" width="32" height="32" class="size-8 rounded-full object-cover" />}
      {profile.name}
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 md:flex">
      {
        nav.filter((item) => item.href !== '/contact').map((item) => (
          <a
            href={localePath(item.href, lang)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class="rounded-md px-3 py-1.5 text-sm text-zinc-600 transition-colors hover:text-zinc-900 aria-[current=page]:font-medium aria-[current=page]:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 dark:aria-[current=page]:text-zinc-100"
          >
            {t(item.key)}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1">
      <div role="group" aria-label={t('a11y.lang')} class="flex rounded-lg border border-zinc-200 p-0.5 text-xs dark:border-zinc-800">
        {
          (Object.keys(languages) as Lang[]).map((code) => (
            <a
              href={localePath(basePath, code)}
              hreflang={code}
              lang={code}
              data-lang={code}
              aria-current={code === lang ? 'true' : undefined}
              class="rounded-md px-2.5 py-1 text-zinc-500 transition-colors hover:text-zinc-900 aria-[current=true]:bg-zinc-900 aria-[current=true]:text-white dark:hover:text-zinc-100 dark:aria-[current=true]:bg-zinc-100 dark:aria-[current=true]:text-zinc-900"
            >
              {languages[code]}
            </a>
          ))
        }
      </div>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        aria-label={t('a11y.theme')}
      >
        <Icon name="moon" class="dark:hidden" />
        <Icon name="sun" class="hidden dark:block" />
      </button>
      <a
        href={localePath('/contact', lang)}
        aria-current={isActive('/contact') ? 'page' : undefined}
        class="btn-primary ml-1 hidden px-3.5 py-1.5 text-xs md:inline-flex"
      >
        {t('nav.hire')}
      </a>
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md p-2 text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 md:hidden dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
        aria-label={t('a11y.menu')}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={18} class="menu-open" />
        <Icon name="x" size={18} class="menu-close hidden" />
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-zinc-100 md:hidden dark:border-zinc-900">
    <ul class="container-page flex flex-col py-2">
      {
        nav.map((item) => (
          <li>
            <a
              href={localePath(item.href, lang)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="block rounded-lg px-3 py-3 text-base text-zinc-700 hover:bg-zinc-50 aria-[current=page]:font-semibold aria-[current=page]:text-zinc-900 dark:text-zinc-300 dark:hover:bg-zinc-900 dark:aria-[current=page]:text-zinc-50"
            >
              {t(item.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
  });

  const menuButton = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  menuButton?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.querySelector('.menu-open')?.classList.toggle('hidden', open);
    menuButton.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  });

  // Remember the chosen language for next visit.
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((link) => {
    link.addEventListener('click', () => {
      try {
        localStorage.setItem('lang', link.dataset.lang ?? 'en');
      } catch {}
    });
  });
</script>
