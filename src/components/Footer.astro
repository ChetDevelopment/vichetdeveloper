---
import SocialLinks from './SocialLinks.astro';
import { profile } from '../data/site';
import { useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useT(Astro.props.lang);
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-zinc-100 dark:border-zinc-900">
  <div class="container-page flex flex-col-reverse items-start justify-between gap-4 py-8 text-sm text-zinc-500 sm:flex-row sm:items-center">
    <p>© {year} {profile.name}. {t('footer.built')}</p>
    <SocialLinks class="-ml-2 sm:ml-0" />
  </div>
</footer>
