---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  intro?: string;
  id?: string;
  class?: string;
}

const { number, eyebrow, title, intro, id } = Astro.props;
---

<div class:list={['max-w-2xl', Astro.props.class]} data-reveal>
  <p class="eyebrow flex items-center gap-3">
    <span class="font-mono text-accent">{number}</span>
    <span class="h-px w-8 bg-zinc-300 dark:bg-zinc-700" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2 id={id} class="section-title mt-3">{title}</h2>
  {intro && <p class="mt-3 leading-relaxed">{intro}</p>}
</div>
