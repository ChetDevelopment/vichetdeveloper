---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Page not found">
  <section class="container-page py-32 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-2 text-3xl font-bold">Page not found</h1>
    <p class="mt-4">The page you’re looking for doesn’t exist or has moved.</p>
    <p class="mt-1" lang="km">រកមិនឃើញទំព័រដែលអ្នកកំពុងស្វែងរកទេ។</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/km/" class="btn-ghost" lang="km">ត្រឡប់ទៅទំព័រដើម</a>
    </div>
  </section>
</Base>
