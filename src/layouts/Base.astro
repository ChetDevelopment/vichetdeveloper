---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile, seo, skills } from '../data/site';
import { localePath, stripLang, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
}

const { lang, title, description, image } = Astro.props;
const t = useT(lang);

const pageTitle = title ? `${title} — ${profile.name}` : t(seo.title);
const pageDescription = description ?? t(seo.description);
const basePath = stripLang(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const altEn = new URL(localePath(basePath, 'en'), Astro.site);
const altKm = new URL(localePath(basePath, 'km'), Astro.site);
// Pages without their own picture use the shared social card (public/og.png, 1200×630).
const ogImage = new URL(image ?? '/og.png', Astro.site).href;
const isHome = basePath === '/';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

// Structured data: tells Google who this site is about (helps name searches and rich results).
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role.en,
  url: new URL('/', Astro.site).href,
  image: new URL(profile.photo, Astro.site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Phnom Penh', addressCountry: 'KH' },
  alumniOf: { '@type': 'EducationalOrganization', name: 'Passerelles Numériques Cambodia' },
  knowsAbout: [...new Set(skills.flatMap((g) => g.items))].slice(0, 20),
  knowsLanguage: ['km', 'en'],
  sameAs: [profile.github, profile.linkedin, profile.facebook].filter(Boolean),
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${profile.name} — Portfolio`,
  url: new URL('/', Astro.site).href,
  inLanguage: ['en', 'km'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="km" href={altKm} />
    <link rel="alternate" hreflang="x-default" href={altEn} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'km' ? 'km_KH' : 'en_US'} />
    <meta property="og:site_name" content={`${profile.name} — Portfolio`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />}

    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <script is:inline>
      (() => {
        document.documentElement.classList.add('js');
        // Theme: apply saved/system theme before paint to avoid a flash.
        let theme, lang;
        try {
          theme = localStorage.getItem('theme');
          lang = localStorage.getItem('lang');
        } catch {}
        if (!theme) theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.classList.toggle('dark', theme === 'dark');

        // Language: if the visitor chose Khmer before and arrives on an English page
        // from outside the site, send them to the Khmer version.
        const path = location.pathname;
        const onKm = path === '/km' || path.startsWith('/km/');
        let fromInside = false;
        try { fromInside = new URL(document.referrer).origin === location.origin; } catch {}
        if (lang === 'km' && !onKm && !fromInside) {
          location.replace('/km' + (path === '/' ? '/' : path) + location.hash);
        }
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 btn-primary">
      {t('a11y.skip')}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Reveal elements as they scroll into view.
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
